{
  "name": "lablims-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run db:generate && tsc -p tsconfig.build.json && node -e \"import('node:fs').then(fs => fs.cpSync('src/generated', 'dist/generated', { recursive: true }))\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "npm run db:generate",
    "db:generate": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/control/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/control/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/control/schema.prisma",
    "db:lab:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/control/schema.prisma",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}