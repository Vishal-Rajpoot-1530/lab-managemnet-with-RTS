# ---- Server ---------------------------------------------------------------
PORT=4000

# ---- Main database --------------------------------------------------------
# Holds ONLY the super admin and the lab (admin) accounts. Every lab keeps its
# own data (patients, bills, tests, employees...) in its own database, which the
# lab admin connects on the Admin login page. Nothing about a lab goes here.
# If the password contains @ : / # ? write it URL-encoded (@ becomes %40).
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/lab_control

# ---- Login ------------------------------------------------------------------
# Each secret: at least 32 random characters, and all three different. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Signs in to the Super admin panel (kept apart from JWT_SECRET so a lab token can never open it).
SUPER_ADMIN_JWT_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_STRING

# The FIRST super admin. It is created once, the first time the server starts and no super admin
# exists yet. Then sign in at /super-admin with this email and password. After that you can
# delete the password from this file: it is stored hashed in the database.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Encrypts each lab's saved database URL. Never change it once labs are connected,
# or every saved URL becomes unreadable. Keep a backup of it somewhere safe.
TENANT_SECRET=CHANGE_ME_TO_A_THIRD_LONG_RANDOM_STRING

# ---- Optional ---------------------------------------------------------------
# Browser origins allowed to call the API (comma separated). Empty = allow all.
CORS_ORIGIN=http://localhost:5173
# "Today" and daily totals use this time zone.
APP_TIMEZONE=Asia/Kolkata
