# ---- Server ---------------------------------------------------------------
PORT=4000

# ---- MySQL (the ONLY database setting; Prisma reads this) -------------------
# If the password contains @ : / # ? write it URL-encoded (@ becomes %40).
DATABASE_URL="mysql://root:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:3306/lab_lims"

# ---- Login ------------------------------------------------------------------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# The first owner account. It is created in MySQL the first time the backend
# starts (only if no user with this e-mail exists). After that, passwords live in
# the database: change yours in the app (Manage > My account), not here.
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Lab Owner
# Create the hash with:
#   node --input-type=module -e "import b from 'bcryptjs'; console.log(b.hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=put_the_bcrypt_hash_here

# ---- Optional ---------------------------------------------------------------
# Browser origins allowed to call the API (comma separated). Empty = allow all.
CORS_ORIGIN=http://localhost:5173
# "Today" and daily totals use this time zone.
APP_TIMEZONE=Asia/Kolkata
